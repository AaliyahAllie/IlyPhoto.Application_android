<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_gradient">

    <!-- Ily Photo logo -->
    <ImageView
        android:id="@+id/splashLogo"
        android:layout_width="142dp"
        android:layout_height="142dp"
        android:src="@drawable/ily_photo_logo"
        android:scaleType="fitCenter"
        android:contentDescription="Ily Photo logo"
        android:background="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.46" />

    <!-- Loading bar -->
    <ProgressBar
        android:id="@+id/splashProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="10dp"
        android:max="100"
        android:progress="75"
        android:progressDrawable="@drawable/splash_progress_drawable"
        android:indeterminate="false"
        app:layout_constraintWidth_percent="0.76"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/splashCaption"
        android:layout_marginBottom="4dp" />

    <!-- Caption under the loading bar -->
    <TextView
        android:id="@+id/splashCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="capturing the moment"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:fontFamily="sans"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="190dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
