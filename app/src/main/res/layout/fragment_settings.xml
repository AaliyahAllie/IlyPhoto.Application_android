<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_lilac_green_gradient">

    <!-- Top Header: Logo -->
    <ImageView
        android:id="@+id/settingsLogo"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ily_photo_logo"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name"
        android:background="#FFFFFF"
        android:padding="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp" />

    <!-- Top Header: Title "SETTINGS" -->
    <TextView
        android:id="@+id/settingsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:fontFamily="sans-serif"
        android:gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toEndOf="@id/settingsLogo"
        app:layout_constraintEnd_toStartOf="@id/btnTopProfile"
        app:layout_constraintTop_toTopOf="@id/settingsLogo"
        app:layout_constraintBottom_toBottomOf="@id/settingsLogo" />

    <!-- Top Right Profile Button -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btnTopProfile"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="20dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/white"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/settingsLogo"
        app:layout_constraintBottom_toBottomOf="@id/settingsLogo"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivTopProfileAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_avatar_girl"
            android:scaleType="centerCrop"
            android:contentDescription="@string/profile" />
    </androidx.cardview.widget.CardView>

    <!-- Top Divider -->
    <View
        android:id="@+id/dividerSettingsTop"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/brand_divider"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/settingsLogo" />

    <!-- Scrollable Settings Content -->
    <ScrollView
        android:id="@+id/settingsScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dividerSettingsTop"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card: Appearance / Dark Mode -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/home_card_background"
                android:elevation="3dp"
                android:padding="16dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvSectionAppearance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/appearance"
                    android:textColor="@color/brand_text_dark"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Dark Mode Row -->
                <TextView
                    android:id="@+id/tvDarkModeLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/dark_mode"
                    android:textColor="@color/brand_text_dark"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/switchDarkMode"
                    app:layout_constraintTop_toBottomOf="@id/tvSectionAppearance" />

                <TextView
                    android:id="@+id/tvDarkModeSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/dark_mode_sub"
                    android:textColor="@color/brand_text_muted"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/switchDarkMode"
                    app:layout_constraintTop_toBottomOf="@id/tvDarkModeLabel" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchDarkMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvDarkModeLabel"
                    app:layout_constraintBottom_toBottomOf="@id/tvDarkModeSub" />

                <View
                    android:id="@+id/divAppearance"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/brand_divider"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/tvDarkModeSub" />

                <!-- Theme Accent Display -->
                <TextView
                    android:id="@+id/tvThemeAccentLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/color_palette"
                    android:textColor="@color/brand_text_dark"
                    android:textSize="14sp"
                    android:layout_marginTop="12dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divAppearance"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/tvThemeAccentVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/palette_name"
                    android:textColor="@color/brand_lilac_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvThemeAccentLabel"
                    app:layout_constraintBottom_toBottomOf="@id/tvThemeAccentLabel" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Card: Language Settings -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/home_card_background"
                android:elevation="3dp"
                android:padding="16dp"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvSectionLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/language_section"
                    android:textColor="@color/brand_text_dark"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvLanguageLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/app_language"
                    android:textColor="@color/brand_text_dark"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvSectionLanguage" />

                <TextView
                    android:id="@+id/tvCurrentLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="English (South Africa)"
                    android:textColor="@color/brand_lilac_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvLanguageLabel"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/brand_lilac_dark"
                    android:contentDescription="Select language"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvCurrentLanguage"
                    app:layout_constraintBottom_toBottomOf="@id/tvCurrentLanguage" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Card: Notifications -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/home_card_background"
                android:elevation="3dp"
                android:padding="16dp"
                android:layout_marginTop="14dp">

                <TextView
                    android:id="@+id/tvSectionNotif"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/notifications_section"
                    android:textColor="@color/brand_text_dark"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Booking Reminders -->
                <TextView
                    android:id="@+id/tvNotifBooking"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/booking_reminders"
                    android:textColor="@color/brand_text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/switchNotifBooking"
                    app:layout_constraintTop_toBottomOf="@id/tvSectionNotif" />

                <TextView
                    android:id="@+id/tvNotifBookingSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/booking_reminders_sub"
                    android:textColor="@color/brand_text_muted"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/switchNotifBooking"
                    app:layout_constraintTop_toBottomOf="@id/tvNotifBooking" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchNotifBooking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvNotifBooking"
                    app:layout_constraintBottom_toBottomOf="@id/tvNotifBookingSub" />

                <View
                    android:id="@+id/divNotif"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/brand_divider"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@id/tvNotifBookingSub" />

                <!-- Gallery Alerts -->
                <TextView
                    android:id="@+id/tvNotifGallery"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/gallery_alerts"
                    android:textColor="@color/brand_text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/switchNotifGallery"
                    app:layout_constraintTop_toBottomOf="@id/divNotif" />

                <TextView
                    android:id="@+id/tvNotifGallerySub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/gallery_alerts_sub"
                    android:textColor="@color/brand_text_muted"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/switchNotifGallery"
                    app:layout_constraintTop_toBottomOf="@id/tvNotifGallery"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchNotifGallery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvNotifGallery"
                    app:layout_constraintBottom_toBottomOf="@id/tvNotifGallerySub" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Card: Account & Studio Info -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/home_card_background"
                android:elevation="3dp"
                android:padding="16dp"
                android:layout_marginTop="14dp">

                <TextView
                    android:id="@+id/tvSectionAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/account_section"
                    android:textColor="@color/brand_text_dark"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Current User Email -->
                <TextView
                    android:id="@+id/tvAccountEmailLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/logged_in_as"
                    android:textColor="@color/brand_text_muted"
                    android:textSize="12sp"
                    android:layout_marginTop="10dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvSectionAccount" />

                <TextView
                    android:id="@+id/tvAccountEmailValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="client@ilyphoto.co.za"
                    android:textColor="@color/brand_text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvAccountEmailLabel" />

                <!-- Reset Password Button -->
                <TextView
                    android:id="@+id/btnResetPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/login_button_background"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/change_password"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvAccountEmailLabel"
                    app:layout_constraintBottom_toBottomOf="@id/tvAccountEmailValue" />

                <View
                    android:id="@+id/divAccount"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/brand_divider"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/tvAccountEmailValue" />

                <!-- Studio Terms Row -->
                <TextView
                    android:id="@+id/btnStudioTerms"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/studio_terms"
                    android:textColor="@color/brand_lilac_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/ivTermsArrow"
                    app:layout_constraintTop_toBottomOf="@id/divAccount"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <ImageView
                    android:id="@+id/ivTermsArrow"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/brand_lilac_dark"
                    android:contentDescription="Terms"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/btnStudioTerms"
                    app:layout_constraintBottom_toBottomOf="@id/btnStudioTerms" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- App Version -->
            <TextView
                android:id="@+id/tvAppVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_version_label"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp" />

            <!-- Log Out Button -->
            <TextView
                android:id="@+id/btnSettingsLogOut"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/button_red_background"
                android:elevation="4dp"
                android:gravity="center"
                android:text="@string/log_out"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="16dp" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:background="@drawable/bottom_nav_background"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:weightSum="3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_home"
                android:contentDescription="@string/home" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_settings"
                app:tint="#5E4F73"
                android:contentDescription="@string/settings" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/navMenu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_menu"
                android:contentDescription="@string/menu" />
        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
