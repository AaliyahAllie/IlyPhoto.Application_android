<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_conflict_background"
    android:elevation="12dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="24dp">

    <!-- Header: Photo Title -->
    <TextView
        android:id="@+id/tvPreviewTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Matric Dance Golden Hour"
        android:textColor="@color/brand_text_dark"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnPreviewDismiss"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/btnPreviewDismiss"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_chevron_right"
        android:contentDescription="Close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvPreviewCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Matric Ball 2026 • High Resolution"
        android:textColor="#757575"
        android:textSize="12sp"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPreviewTitle" />

    <!-- Photo Display Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardPhotoFrame"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:layout_marginTop="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPreviewCategory">

        <FrameLayout
            android:id="@+id/photoPreviewBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_photo_matric">

            <ImageView
                android:id="@+id/ivPreviewPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_image_placeholder"
                android:contentDescription="Photo Preview" />

            <TextView
                android:id="@+id/tvWatermarkBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="10dp"
                android:background="#80000000"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="ILY PHOTO • HD"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Photographer Credit -->
    <TextView
        android:id="@+id/tvPhotographerCredit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Shot by Aysha Allie • ILY PHOTO Cape Town"
        android:textColor="@color/brand_text_dark"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardPhotoFrame" />

    <!-- Description -->
    <TextView
        android:id="@+id/tvPreviewDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Professional high-definition capture formatted for client download and print."
        android:textColor="#555555"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPhotographerCredit" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:id="@+id/layoutPreviewActions"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPreviewDescription"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/btnDownloadSinglePhoto"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/login_button_background"
            android:gravity="center"
            android:text="SAVE TO DEVICE"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnClosePreviewDialog"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:background="@drawable/input_grey_background"
            android:gravity="center"
            android:text="@string/close"
            android:textColor="@color/brand_text_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginStart="10dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
