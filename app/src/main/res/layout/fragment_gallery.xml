<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_lilac_green_gradient">

    <!-- Top Header: Logo -->
    <ImageView
        android:id="@+id/galleryLogo"
        android:layout_width="74dp"
        android:layout_height="78dp"
        android:src="@drawable/ily_photo_logo"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name"
        android:background="#FFFFFF"
        android:padding="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp" />

    <!-- Top Header: Title "ILY PHOTO." -->
    <TextView
        android:id="@+id/galleryTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/ily_photo_title"
        android:textColor="@color/white"
        android:textSize="26sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toEndOf="@id/galleryLogo"
        app:layout_constraintEnd_toStartOf="@id/btnTopProfile"
        app:layout_constraintTop_toTopOf="@id/galleryLogo"
        app:layout_constraintBottom_toBottomOf="@id/galleryLogo" />

    <!-- Top Right Profile Button -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btnTopProfile"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="20dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/white"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/galleryLogo"
        app:layout_constraintBottom_toBottomOf="@id/galleryLogo"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivTopProfileAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_avatar_girl"
            android:scaleType="centerCrop"
            android:contentDescription="@string/profile" />
    </androidx.cardview.widget.CardView>

    <!-- Top Divider above "GALLERY" -->
    <View
        android:id="@+id/dividerGalleryTop"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/brand_divider"
        android:layout_marginTop="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/galleryLogo" />

    <!-- Section Title: "GALLERY" -->
    <TextView
        android:id="@+id/gallerySectionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/gallery"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:letterSpacing="0.06"
        android:fontFamily="sans-serif"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dividerGalleryTop" />

    <!-- Bottom Divider below "GALLERY" -->
    <View
        android:id="@+id/dividerGalleryBottom"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/brand_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gallerySectionLabel" />

    <!-- Header Pill: My Client Albums -->
    <LinearLayout
        android:id="@+id/btnEventNameDropdown"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:background="@drawable/dropdown_pill_background"
        android:elevation="3dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:layout_marginTop="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dividerGalleryBottom">

        <TextView
            android:id="@+id/tvSelectedEventName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Private Albums"
            android:textColor="@color/brand_text_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.03" />
    </LinearLayout>

    <!-- Scrollable container for dynamic Azure Blob Storage photo cards -->
    <ScrollView
        android:id="@+id/scrollGallery"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnEventNameDropdown"
        app:layout_constraintBottom_toTopOf="@id/btnDownloadGallery">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <!-- Clean Empty State Card matching Website -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardEmptyGallery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/home_card_background"
                android:elevation="4dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="32dp"
                android:paddingBottom="32dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvEmptyCameraEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📷"
                    android:textSize="48sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvEmptyGalleryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Galleries Uploaded Yet"
                    android:textColor="@color/brand_text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="14dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvEmptyCameraEmoji" />

                <TextView
                    android:id="@+id/tvEmptyGalleryDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Once your photography session has taken place and your pictures are professionally edited, Aysha will upload your gallery right here for you to view and download!"
                    android:textColor="@color/brand_text_muted"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvEmptyGalleryTitle" />

                <TextView
                    android:id="@+id/btnEmptyGalleryBook"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/login_button_background"
                    android:elevation="2dp"
                    android:gravity="center"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/make_a_booking"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="18dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvEmptyGalleryDesc"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Dynamic container for real Azure Blob Storage photos -->
            <LinearLayout
                android:id="@+id/layoutGalleryContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <!-- "Download full Gallery" Pill Button -->
    <TextView
        android:id="@+id/btnDownloadGallery"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/login_button_background"
        android:elevation="4dp"
        android:gravity="center"
        android:text="@string/download_full_gallery"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:letterSpacing="0.03"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar" />

    <!-- Full Screen Photo Preview Overlay Modal (hidden by default) -->
    <FrameLayout
        android:id="@+id/photoPreviewOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <include
            android:id="@+id/dialogPhotoPreview"
            layout="@layout/dialog_photo_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp" />
    </FrameLayout>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:background="@drawable/bottom_nav_background"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:weightSum="3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Home Tab -->
        <FrameLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_home"
                android:contentDescription="@string/home" />
        </FrameLayout>

        <!-- Settings Tab -->
        <FrameLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/settings" />
        </FrameLayout>

        <!-- Menu Tab -->
        <FrameLayout
            android:id="@+id/navMenu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_menu"
                android:contentDescription="@string/menu" />
        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
